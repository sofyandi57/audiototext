# Copy to .env and adjust. Placeholders only — never commit real secrets.

# Optional shared access token. When set, every /api route except /api/health
# requires it (Settings page -> "Token akses"). Strongly recommended on a public URL.
MI_ACCESS_TOKEN=

# Where uploads, generated audio, models and the SQLite DB live (outside any public dir).
MI_DATA_DIR=./data
# Built frontend (npm run build in frontend/). Served at "/".
MI_FRONTEND_DIR=./frontend/out

# Limits
MI_MAX_PDF_MB=50
MI_MAX_MEDIA_MB=500
MI_MAX_PDF_PAGES=1500
MI_MAX_MEDIA_MINUTES=240

# Retention: delete uploads + derived files after N days (0 = never)
MI_RETENTION_DAYS=30

# Worker: run inside the API process (simple) or as a separate `python -m app.worker`
MI_RUN_WORKER_IN_PROCESS=true

# PDF / OCR
MI_OCR_ENABLED=true
MI_OCR_LANGUAGES=ind+eng
MI_SECTION_MAX_CHARS=6000

# TTS: espeak-ng (verified) | piper (needs local voice file)
MI_TTS_ENGINE=espeak-ng
MI_TTS_VOICE=id
MI_TTS_RATE_WPM=160
MI_PIPER_MODEL_PATH=

# ASR (faster-whisper). Model name (tiny/base/small/medium/large-v3) or local folder.
MI_WHISPER_MODEL=small
MI_WHISPER_COMPUTE_TYPE=int8
# true = never download at request time; pre-download with: python -m app.cli download-asr-model small
MI_WHISPER_LOCAL_FILES_ONLY=true
MI_WHISPER_DOWNLOAD_ROOT=
MI_ASR_LANGUAGE=id
MI_ASR_CHUNK_SECONDS=300
# Comma-separated names/terms to bias recognition (optional)
MI_ASR_INITIAL_PROMPT=

# Meeting analysis: rules (default, deterministic) | ollama (local LLM, unverified)
MI_INTELLIGENCE_ENGINE=rules
MI_OLLAMA_URL=
MI_OLLAMA_MODEL=
